# Скиллы агентов: сами файлы лежат в .agents/ и коммитятся.
# .claude/skills — локальный слой обнаружения из ссылок с абсолютными путями
# на .agents/skills; при core.symlinks=false git записал бы содержимое повторно.
.claude/skills/

# Снапшоты, логи и скриншоты MCP-сервера Playwright: он пишет их в cwd
# при каждом вызове браузера.
.playwright-mcp/

# Состояние и лог Ralph-цикла (.claude/hooks/stop.mjs): пишутся при каждом шаге
# цикла и у каждой машины свои.
.claude/ralph.iterations.json
.claude/ralph.log

# Клиент Prisma генерируется из схемы (bun run db:generate)
apps/api/generated/

# Загруженные файлы встреч: каталог задаётся UPLOAD_DIR, дефолт — apps/api/.uploads.
# Часть состояния приложения живёт здесь, мимо compose и мимо репозитория.
apps/api/.uploads/
