{
  "name": "@video-meetings/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "NODE_ENV=production bun run src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0"
  }
}
