PORT=3000
HOST=0.0.0.0

# Список origin'ов через запятую, которым разрешён доступ к API.
CORS_ORIGINS=http://localhost:5173

# Postgres из корневого docker-compose.yml (bun run db:up).
DATABASE_URL=postgresql://video_meetings:video_meetings@localhost:5432/video_meetings

# Секрет подписи JWT (HS256). Дефолта нет намеренно: приложение не должно
# стартовать с предсказуемым секретом. Свой: openssl rand -base64 48
JWT_SECRET=change-me-in-your-own-env

# Время жизни токена в формате jose: 15m, 12h, 7d.
JWT_EXPIRES_IN=7d
