# production выключает Scalar UI на /docs и спеку /docs/json; тесты ставят test.
NODE_ENV=development

PORT=3000
HOST=0.0.0.0

# Список origin'ов через запятую, которым разрешён доступ к API.
CORS_ORIGINS=http://localhost:5173

# Postgres из корневого docker-compose.yml (bun run db:up). Хост — 127.0.0.1, а
# не localhost: compose публикует порт только на IPv4-loopback, а localhost на
# части систем первым резолвится в ::1, где порта нет.
DATABASE_URL=postgresql://video_meetings:video_meetings@127.0.0.1:5432/video_meetings

# Секрет подписи JWT (HS256). Пустой намеренно: приложение не должно стартовать
# с предсказуемым секретом, а значение из этого файла известно всем. Не короче
# 32 байт — короткий api отвергает на старте. Свой: openssl rand -base64 48
JWT_SECRET=

# Время жизни токена в формате jose: 15m, 12h, 7d.
JWT_EXPIRES_IN=7d

# Срок ссылки на файл (поле url в списке файлов), формат тот же. Минуты, а не
# часы: ссылка утекает вместе с историей браузера и логами прокси.
FILE_LINK_EXPIRES_IN=15m

# Каталог с загруженными файлами встреч и аватарами (подкаталог avatars/).
# Относительный путь разворачивается от рабочего каталога процесса (apps/api при
# bun run dev:api). В git не попадает.
UPLOAD_DIR=./.uploads

# Потолок тела запроса у Bun.serve, байты; дефолт 64 ГиБ. Держится далеко над
# лимитом записи (2 ГиБ): сверх потолка Bun отвечает сам — без CORS-заголовков и с
# обрывом соединения, — и браузер видит «нет связи» вместо нашего 413 с текстом.
MAX_REQUEST_BODY_SIZE=68719476736
