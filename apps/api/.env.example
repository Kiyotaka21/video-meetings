PORT=3000
HOST=0.0.0.0

# Список origin'ов через запятую, которым разрешён доступ к API.
CORS_ORIGINS=http://localhost:5173

# Postgres из корневого docker-compose.yml (bun run db:up).
DATABASE_URL=postgresql://video_meetings:video_meetings@localhost:5432/video_meetings

# Секрет подписи JWT (HS256). Дефолта нет намеренно: приложение не должно
# стартовать с предсказуемым секретом. Свой: openssl rand -base64 48
JWT_SECRET=change-me-in-your-own-env

# Время жизни токена в формате jose: 15m, 12h, 7d.
JWT_EXPIRES_IN=7d

# Каталог с загруженными файлами встреч. Относительный путь разворачивается от
# рабочего каталога процесса (apps/api при bun run dev:api). В git не попадает.
UPLOAD_DIR=./.uploads

# Потолок тела запроса у Bun.serve, байты; дефолт 64 ГиБ. Держится далеко над
# лимитом записи (2 ГиБ): сверх потолка Bun отвечает сам — без CORS-заголовков и с
# обрывом соединения, — и браузер видит «нет связи» вместо нашего 413 с текстом.
MAX_REQUEST_BODY_SIZE=68719476736
