{
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Bash(bun run test)",
      "Bash(bun run test:api)",
      "Bash(bun run check)",
      "Bash(bun run lint)",
      "Bash(bun run lint:fix)",
      "Bash(bun run typecheck)",
      "Bash(bun run format)",
      "Bash(bun run db:up)",
      "Bash(bun run db:migrate)",
      "Bash(bun run db:generate)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push origin *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/stop.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/format-file.mjs\"",
            "timeout": 30,
            "statusMessage": "Prettier форматирует файл…"
          }
        ]
      }
    ]
  }
}
