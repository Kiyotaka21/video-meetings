{
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Bash(npm run test)",
      "Bash(npm run test:e2e)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(npx prisma *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/stop.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/format-file.mjs\"",
            "timeout": 30,
            "statusMessage": "Prettier форматирует файл…"
          }
        ]
      }
    ]
  }
}
