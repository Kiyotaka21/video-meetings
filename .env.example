# Переменные для docker-compose.yml (Postgres). Compose читает `.env` из корня
# репозитория; у каждого приложения свой `.env` в apps/<app>/.
# Значения ниже совпадают с дефолтами в docker-compose.yml — файл нужен, только
# если хочется их переопределить.

POSTGRES_USER=video_meetings
POSTGRES_PASSWORD=video_meetings
POSTGRES_DB=video_meetings

# Порт на хосте; внутри сети compose Postgres всегда слушает 5432.
POSTGRES_PORT=5432
